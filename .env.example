# Ключ OpenWeatherMap: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Токен сообщества VK для Bots Long Poll: Управление → Дополнительно → Работа с API → Ключи доступа (право messages)
VK_BOT_TOKEN=your_vk_community_token_here

# Числовой ID сообщества VK: Управление → Дополнительно → Основная информация
VK_GROUP_ID=your_vk_group_id_here
